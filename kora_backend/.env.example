# Local database fallback
# Set DB_ENGINE=sqlite to use a local SQLite database instead of PostgreSQL.
# DB_ENGINE=sqlite
# DB_NAME=kora_db
# DB_USER=kora_user
# DB_PASSWORD=kora_password123
# DB_HOST=localhost
# DB_PORT=5432

# Frontend URL for CORS and admin "View on Site" links (default: http://localhost:3000)
# Update this when frontend runs on a different host/port
# FRONTEND_BASE_URL=http://localhost:3000

# CORS Configuration
# The backend automatically allows:
#   - http://localhost:3000, http://localhost:3001
#   - http://127.0.0.1:3000, http://127.0.0.1:3001
#   - Any address matching http://192.168.x.x:30xx (dev LAN access)
#   - The FRONTEND_BASE_URL above
# To allow additional origins in DEBUG mode, set FRONTEND_BASE_URL accordingly.
