# Kora Mobile — Environment Configuration
#
# ⚠️  This file is a REFERENCE only. Flutter does NOT auto-load .env files.
# Pass values at build time with --dart-define:
#
#   flutter run --dart-define=KORA_API_BASE_URL=http://localhost:8000/api/
#
# For Android emulator, use 10.0.2.2 instead of localhost:
#   flutter run --dart-define=KORA_API_BASE_URL=http://10.0.2.2:8000/api/

# Backend base URL per platform:
#   - Flutter Web:        http://localhost:8000/api/          (default)
#   - iOS simulator:      http://localhost:8000/api/
#   - Desktop:            http://localhost:8000/api/
#   - Android emulator:   http://10.0.2.2:8000/api/
#   - Physical device:    http://<host-lan-ip>:8000/api/
#   - Production:         https://api.yourdomain.com/api/
KORA_API_BASE_URL=http://localhost:8000/api/

# Connection timeouts in milliseconds
KORA_CONNECT_TIMEOUT_MS=15000
KORA_RECEIVE_TIMEOUT_MS=20000

# Polling intervals in seconds
KORA_MONITORING_POLL_SECONDS=5
KORA_ALARMS_POLL_SECONDS=30
KORA_NOTIFICATIONS_POLL_SECONDS=60

# Optional — Chapa public key (used only for non-hosted-checkout experiments)
# KORA_CHAPA_PUBLIC_KEY=
